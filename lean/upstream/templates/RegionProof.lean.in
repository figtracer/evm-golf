import PowerRegion
import $decode_module
set_option Elab.async false
set_option maxRecDepth 4096
set_option maxHeartbeats 2000000
open EvmYul EvmYul.EVM GolfUpstream
namespace $namespace
def compilerPower (s : EVM.State) (a b c : UInt256) (tail : List UInt256) : EVM.State :=
  GolfPowerRegion.compilerPower originalCode s a b c tail

def compilerAdd (s : EVM.State) (a b c : UInt256) (tail : List UInt256) : EVM.State :=
  GolfPowerRegion.compilerAdd originalCode s a b c tail

def compilerSwap (s : EVM.State) (a b c : UInt256) (tail : List UInt256) : EVM.State :=
  GolfPowerRegion.compilerSwap originalCode s a b c tail

def compilerZero (s : EVM.State) (a b c : UInt256) (tail : List UInt256) : EVM.State :=
  GolfPowerRegion.compilerZero originalCode s a b c tail

def compilerDupA (s : EVM.State) (a b c : UInt256) (tail : List UInt256) : EVM.State :=
  GolfPowerRegion.compilerDupA originalCode s a b c tail

def compilerDupB (s : EVM.State) (a b c : UInt256) (tail : List UInt256) : EVM.State :=
  GolfPowerRegion.compilerDupB originalCode s a b c tail

def compilerExit (s : EVM.State) (a b c : UInt256) (tail : List UInt256) : EVM.State :=
  GolfPowerRegion.compilerExit originalCode $destination s a b c tail

theorem compilerTrace (s : EVM.State) (a b c : UInt256) (tail : List UInt256) (fuel : Nat)
    (pc : s.pc = UInt256.ofNat $entry_pc) (stack : s.stack = a :: b :: c :: tail)
    (gas : 25 ≤ s.gasAvailable.toNat) (peak : tail.length + 6 ≤ 1024) :
    OpenRegionTrace originalCode candidateCode (fuel+1) (fuel+9) 1 s (compilerExit s a b c tail) :=
  GolfPowerRegion.compilerTrace originalCode candidateCode $entry_pc $destination originalAddDecoded originalSwapDecoded originalZeroDecoded originalDupADecoded originalDupBDecoded originalTargetDecoded candidateAddDecoded candidateSwapDecoded candidateZeroDecoded candidateDupADecoded candidateDupBDecoded candidateTargetDecoded originalSite candidateSite s a b c tail fuel pc stack gas peak

theorem compilerExitPC (s : EVM.State) (a b c : UInt256) (tail : List UInt256) (pc : s.pc = UInt256.ofNat $entry_pc) :
    (compilerExit s a b c tail).pc = UInt256.ofNat $exit_pc :=
  GolfPowerRegion.compilerExitPC originalCode $entry_pc $destination s a b c tail pc

theorem compilerExitStack (s : EVM.State) (a b c : UInt256) (tail : List UInt256) :
    (compilerExit s a b c tail).stack =
      UInt256.ofNat $destination :: UInt256.ofNat 0 :: UInt256.ofNat 0 :: UInt256.ofNat 0 :: c ::
        (UInt256.add (UInt256.mul (UInt256.ofNat 32) a) b) :: tail :=
  GolfPowerRegion.compilerExitStack originalCode $destination s a b c tail

theorem compilerExitGas (s : EVM.State) (a b c : UInt256) (tail : List UInt256)
    (gas : 25 ≤ s.gasAvailable.toNat) :
    (compilerExit s a b c tail).gasAvailable.toNat = s.gasAvailable.toNat - 25 :=
  GolfPowerRegion.compilerExitGas originalCode $destination s a b c tail gas

theorem compiler_region_boundary (owner : AccountAddress) (s t : EVM.State)
    (a b c : UInt256) (tail : List UInt256) (fuel surplus : Nat)
    (oldJumps newJumps : Array UInt256)
    (related : DeployedFrameWithGas owner originalCode candidateCode surplus s t)
    (pc : s.pc = UInt256.ofNat $entry_pc) (stack : s.stack = a :: b :: c :: tail)
    (gas : 25 ≤ s.gasAvailable.toNat) (peak : tail.length + 6 ≤ 1024) :
    ∃ candidateExit : EVM.State,
      X (fuel+9) oldJumps s = X (fuel+1) oldJumps (compilerExit s a b c tail) ∧
      X (fuel+9) newJumps t = X (fuel+1) newJumps candidateExit ∧
      DeployedFrameWithGas owner originalCode candidateCode (surplus+2) (compilerExit s a b c tail) candidateExit ∧
      (compilerExit s a b c tail).pc = UInt256.ofNat $exit_pc ∧
      candidateExit.pc = UInt256.ofNat $exit_pc ∧
      decode originalCode (compilerExit s a b c tail).pc = some (.JUMP,none) ∧
      decode candidateCode candidateExit.pc = some (.JUMP,none) :=
  GolfPowerRegion.compiler_region_boundary originalCode candidateCode $entry_pc $destination originalAddDecoded originalSwapDecoded originalZeroDecoded originalDupADecoded originalDupBDecoded originalTargetDecoded candidateAddDecoded candidateSwapDecoded candidateZeroDecoded candidateDupADecoded candidateDupBDecoded candidateTargetDecoded originalSite candidateSite originalJumpDecoded candidateJumpDecoded owner s t a b c tail fuel surplus oldJumps newJumps related pc stack gas peak

#print axioms compilerTrace
#print axioms compiler_region_boundary
end $namespace
