import $decode_module
import MixedTrace
import $trace_module
set_option Elab.async false
set_option maxRecDepth 4096
set_option maxHeartbeats 2000000
open EvmYul EvmYul.EVM GolfUpstream GolfCountOffset CanonicalMaskWindow GolfComposition
namespace $namespace
$state_definitions

theorem source_gas (s : EVM.State) $input_binders (tail : List UInt256)
    (gas : $source_gas ≤ s.gasAvailable.toNat) :
    ($source_final).gasAvailable.toNat = s.gasAvailable.toNat - $source_gas := by
  exact GolfSpanTrace.source_gas originalCode candidateCode s $input_arguments tail gas

theorem bound_trace (s : EVM.State) $input_binders (tail : List UInt256) (fuel : Nat)
    (pc : s.pc = UInt256.ofNat $entry_pc) (stack : s.stack = $input_stack)
    (gas : $source_gas ≤ s.gasAvailable.toNat) (height : tail.length ≤ $maximum_tail) :
    MixedTrace originalCode candidateCode (fuel+1) (fuel+($source_steps+1))
      (fuel+($candidate_steps+1)) $powers $masks s ($source_final) := by
  exact GolfSpanTrace.bound_trace originalCode candidateCode $decode_arguments s $input_arguments tail fuel pc stack gas height

theorem source_stack (s : EVM.State) $input_binders (tail : List UInt256)
    (stack : s.stack = $input_stack) :
    ($source_final).stack = $output_stack := by
  exact GolfSpanTrace.source_stack originalCode candidateCode s $input_arguments tail stack

theorem source_count (s : EVM.State) $input_binders (tail : List UInt256) :
    ($source_final).execLength = s.execLength + $source_steps := by
  exact GolfSpanTrace.source_count originalCode candidateCode s $input_arguments tail

theorem source_pc (s : EVM.State) $input_binders (tail : List UInt256)
    (pc : s.pc = UInt256.ofNat $entry_pc) :
    ($source_final).pc = UInt256.ofNat $exit_pc := by
  exact GolfSpanTrace.source_pc originalCode candidateCode s $input_arguments tail pc

theorem span_boundary {owner surplus skipped s t}
    (related : DeployedOffset owner originalCode candidateCode surplus skipped s t)
    $input_binders (tail : List UInt256) (fuel : Nat) (oldJumps newJumps : Array UInt256)
    (pc : s.pc = UInt256.ofNat $entry_pc) (stack : s.stack = $input_stack)
    (gas : $source_gas ≤ s.gasAvailable.toNat) (height : tail.length ≤ $maximum_tail) :
    ∃ ce,
      X (fuel+($source_steps+1)) oldJumps s = X (fuel+1) oldJumps ($source_final) ∧
      X (fuel+($candidate_steps+1)) newJumps t = X (fuel+1) newJumps ce ∧
      DeployedOffset owner originalCode candidateCode (surplus+2*$powers+9*$masks)
        (skipped+3*$masks) ($source_final) ce := by
  exact GolfSpanTrace.span_boundary originalCode candidateCode $decode_arguments related $input_arguments tail fuel oldJumps newJumps pc stack gas height

#print axioms source_gas
#print axioms bound_trace
#print axioms source_stack
#print axioms source_count
#print axioms source_pc
#print axioms span_boundary
end $namespace
